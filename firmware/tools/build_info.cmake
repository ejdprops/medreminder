# Writes build_info.h with `git describe` of the repo (run every build by main/CMakeLists.txt).
# The file is only rewritten when the text changes, so unchanged builds don't recompile.
#   cmake -DREPO=<repo dir> -DOUT=<header> -P build_info.cmake
execute_process(
    COMMAND git describe --tags --match "fw-v*" --dirty --always
    WORKING_DIRECTORY "${REPO}"
    OUTPUT_VARIABLE desc
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR desc STREQUAL "")
    set(desc "unknown")
endif()
file(WRITE "${OUT}.tmp" "/* Generated by tools/build_info.cmake. */\n#pragma once\n#define BUILD_GIT_DESC \"${desc}\"\n")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
file(REMOVE "${OUT}.tmp")
