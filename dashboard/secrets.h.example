/* Copy to secrets.h (same folder; git ignores it) and fill in. Never commit secrets.h.
 * Without secrets.h the dashboard builds with Wi-Fi off (no weather or calendar). */
#pragma once

#define DASH_WIFI_SSID "your network name"
#define DASH_WIFI_PASSWORD "your Wi-Fi password"

/* Weather location: latitude/longitude in decimal degrees (2 decimals is enough, ~1 km).
 * Apple Maps: drop a pin, swipe up on it; Google Maps: right-click a spot, the first line. */
#define DASH_LATITUDE "41.88"
#define DASH_LONGITUDE "-87.63"

/* Cozi calendar feed (.ics URL from Cozi's calendar sharing); "" until the calendar step */
#define DASH_COZI_URL ""
